# ----------------------------------------------------------------------
# Dr. Festus Fadeyi @ 85 — environment configuration
# Copy to .env and fill in. Never commit .env.
# ----------------------------------------------------------------------
APP_NAME="Dr. FF @ 85"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://drffat85.com
APP_TIMEZONE=Africa/Lagos

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# Comma-separated proxy IPs/CIDRs in front of the app (load balancer, Cloudflare), or * if behind a trusted platform proxy
TRUSTED_PROXIES=127.0.0.1

# --- Database (PostgreSQL recommended; MySQL 8 also supported) ---------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ff85
DB_USERNAME=ff85
DB_PASSWORD=

# --- Sessions: secure, http-only cookies -------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# --- Email (PENDING CLIENT: domain + provider credentials) -------------
# Brevo SMTP relay shown; Zoho / Mailchimp Transactional SMTP work the same way.
# Until configured, keep MAIL_MAILER=log: emails are written to the log and
# recorded as "logged (not delivered)" in the dashboard — never as sent.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="Invitation@Dr.FFat85.com"
MAIL_FROM_NAME="Dr. FF@85 Planning Committee"
MAIL_REPLY_TO_ADDRESS="Invitation@Dr.FFat85.com"

# --- Payments: Paystack (PENDING CLIENT) -------------------------------
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
# Charity's settlement account as a Paystack subaccount (ACCT_xxxxx), so funds settle directly to it.
PAYSTACK_SUBACCOUNT_CODE=
PAYSTACK_FEE_BEARER=subaccount

# --- Charity (PENDING CLIENT) ------------------------------------------
CHARITY_NAME=
CHARITY_BANK_NAME=
CHARITY_ACCOUNT_NAME=
CHARITY_ACCOUNT_NUMBER=

# --- Event rules (defaults match the brief) ----------------------------
EVENT_CAPACITY=150
RSVP_MAX_PARTY_SIZE=2
RSVP_DEADLINE="2026-12-04 23:59:59"
DONATION_MIN_NAIRA=1000

# --- Email schedule (Lagos time) ---------------------------------------
EMAIL_RSVP_REMINDER_AT="2026-11-26 10:00:00"
EMAIL_EVENT_REMINDER_AT="2026-12-07 10:00:00"
EMAIL_DAY_OF_AT="2026-12-10 07:00:00"
EMAIL_THANK_YOU_AT="2026-12-11 10:00:00"

# --- Venue map (optional override with the verified pin) ---------------
VENUE_MAP_EMBED_URL=
VENUE_MAP_LINK=
